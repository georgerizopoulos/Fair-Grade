DATABASE_URL=file:./dev.db
# Production: a long random value (the backend refuses to start with this one)
JWT_SECRET=change-me
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
LLM_MODEL=mistral.mistral-large-2402-v1:0
PORT=3001
CORS_ORIGIN=http://localhost:3000
# AI grading worker: set to "off" to stop it picking up submitted papers
AI_WORKER=on
# POST /auth/register is public and lets the caller pick a role: keep it off.
# The app creates accounts through POST /users. Turn on for local scripts only.
ALLOW_REGISTER=off
