DATABASE_URL=file:./dev.db
# Production: a long random value (the backend refuses to start with this one
# when NODE_ENV=production)
JWT_SECRET=change-me
# Set to production on a real server (see README, "Production")
# NODE_ENV=production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
LLM_MODEL=mistral.mistral-large-2402-v1:0
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Behind a reverse proxy: how many proxies to trust (1), "loopback", or a CIDR list.
# Unset = off. Needed so the sign-in limits see the client and not the proxy.
# TRUST_PROXY=1
# AI grading worker: set to "off" to stop it picking up submitted papers
AI_WORKER=on
